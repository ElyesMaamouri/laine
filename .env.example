# Copier ce fichier en .env.local (local) et recopier les mêmes variables dans Vercel
# (Project → Settings → Environment Variables). Ne jamais commiter les vraies valeurs.

# --- Sessions et administration (obligatoire en ligne)
# Secret aléatoire de 64 caractères : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Données en ligne : Upstash Redis (gratuit)
# Vercel → Storage → Upstash (Redis) → Connect : ces 2 variables sont ajoutées automatiquement.
# Absentes (en local) : les données restent dans data/db.json.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Images en ligne : Cloudinary (gratuit)
# cloudinary.com → Dashboard → « API environment variable ».
# Absente (en local) : les images restent dans data/uploads.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Rendu IA réaliste : huggingface (gratuit, test) | fashn (payant)
# Par défaut : fashn si FASHN_API_KEY est renseignée, sinon huggingface.
# TRYON_PROVIDER=huggingface
# Jeton gratuit (huggingface.co → Settings → Access Tokens, type « Read ») : plus d'essais par jour.
# HF_TOKEN=
# HF_SPACE=yisol/IDM-VTON
# FASHN_API_KEY=
# FASHN_MODEL=tryon-v1.6
