# Copier ce fichier en .env.local (tout est optionnel).

# Fournisseur du rendu IA réaliste : huggingface (gratuit, test) | fashn (payant)
# Par défaut : fashn si FASHN_API_KEY est renseignée, sinon huggingface.
# TRYON_PROVIDER=huggingface

# --- Hugging Face (gratuit) ---
# Jeton gratuit (huggingface.co -> Settings -> Access Tokens, type "Read") :
# donne plus d'essais par jour sur le modèle gratuit.
# HF_TOKEN=
# Space utilisé (modèle IDM-VTON par défaut)
# HF_SPACE=yisol/IDM-VTON

# --- FASHN (payant, production) : https://app.fashn.ai -> API keys ---
# FASHN_API_KEY=
# FASHN_MODEL=tryon-v1.6
